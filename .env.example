# Copy this file to .env before running docker-compose up.

# --- Backend ---
DATABASE_URL=postgresql://testora:testora@localhost:5432/testora
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

# --- LLM providers (self-healing fallback chain: Groq -> Gemini -> OpenRouter -> OpenAI) ---
# At least one must be set for self-healing's LLM step and the NLP step editor to work.
# Heuristic-only healing still works with none configured.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- Frontend ---
VITE_API_URL=http://localhost:4000/api
